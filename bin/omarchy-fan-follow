#!/bin/bash
# Maps power-profile changes onto fan profiles. Started by the fan panel and it exits when
# the shell that started it goes away. A manual fan change (panel or CLI) sticks until the next
# power-profile change, unless "follow" is off.
parent=$PPID
[ -d /sys/devices/platform/thinkpad_acpi ] || exit 0

fan=$(dirname "$(readlink -f "$0")")/omarchyfan

# Put the command on the user's PATH: a symlink in ~/.local/bin (on PATH in Omarchy). Done on every start so it
# heals after an update or a moved plugin folder, and before the lock so a waiting duplicate still does it.
# It only replaces a symlink (ours or a dangling one); a real file with that name is left alone.
link=$HOME/.local/bin/omarchyfan
if [ -L "$link" ] || [ ! -e "$link" ]; then
  mkdir -p "$HOME/.local/bin" && ln -sfn "$fan" "$link"
fi

# ...and the manual page (man omarchyfan), in ~/.local/share/man/man1, which man searches by default. Same rules.
manpage=$(cd "$(dirname "$fan")/.." && pwd)/man/omarchyfan.1
mlink=$HOME/.local/share/man/man1/omarchyfan.1
if [ -f "$manpage" ] && { [ -L "$mlink" ] || [ ! -e "$mlink" ]; }; then
  mkdir -p "$HOME/.local/share/man/man1" && ln -sfn "$manpage" "$mlink"
fi

# LEGACY NAMES. The command used to be called omarchy-fan (with a hyphen). The old command and man page keep working
# for now and will be removed in a future release (delete this block, bin/omarchy-fan and man/omarchy-fan.1 then).
# A link is created or repaired only if there is nothing there, it points into this plugin (even an old version of
# it), or it is broken. Someone else's working link, or a real file, is left alone.
legacy_link() {
  local l=$1 t=$2
  mkdir -p "$(dirname "$l")"
  if [ -L "$l" ]; then
    case "$(readlink "$l")" in
      *thinkpad-fan/*) ;;                    # ours: point it at the current file
      *) [ -e "$l" ] && return ;;            # somebody else's, and it works: hands off
    esac
    ln -sfn "$t" "$l"
  elif [ ! -e "$l" ]; then
    ln -s "$t" "$l"
  fi
}
legacy_link "$HOME/.local/bin/omarchy-fan" "$(dirname "$fan")/omarchy-fan"
legacy_link "$HOME/.local/share/man/man1/omarchy-fan.1" "$(cd "$(dirname "$fan")/.." && pwd)/man/omarchy-fan.1"

exec 9> "${XDG_RUNTIME_DIR:-/tmp}/omarchy-fan-follow.lock"
flock -w 20 9 || exit 0          # one follower at a time; on a shell restart wait for the old one to go

map() { case "$1" in power-saver) echo quiet ;; performance) echo performance ;; *) echo balanced ;; esac; }

# Heal first. A follower that was killed outright (SIGKILL runs no trap, e.g. a hard shell restart) leaves its dbus-monitor behind,
# re-parented to systemd, and that monitor only exits when it next writes, which for PowerProfiles can take days. We hold the lock,
# so no follower of ours owns a monitor that is orphaned like that. One whose parent is a live follower, or anything but
# systemd, is never touched.
for p in $(pgrep -u "$UID" -f "dbus-monitor --system type='signal',interface='org.freedesktop.DBus.Properties',sender='net.hadess.PowerProfiles'" 2>/dev/null); do
  pp=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  [ -n "$pp" ] && [ "$(ps -o comm= -p "$pp" 2>/dev/null)" = systemd ] && kill "$p" 2>/dev/null
done

last=$(powerprofilesctl get)
# setpriv --pdeathsig: the kernel stops the monitor whenever this follower dies, SIGKILL included (the EXIT trap below cannot run then)
pre=(); command -v setpriv >/dev/null && setpriv --pdeathsig TERM true 2>/dev/null && pre=(setpriv --pdeathsig TERM)   # (probed first: if it ever refuses, we run the monitor as before)
exec {mon}< <(stdbuf -oL "${pre[@]}" dbus-monitor --system "type='signal',interface='org.freedesktop.DBus.Properties',sender='net.hadess.PowerProfiles',member='PropertiesChanged'" 2>/dev/null 9>&-)   # 9>&-: the monitor must not inherit the lock, or an orphan would hold it
monpid=$!
trap 'kill $monpid 2>/dev/null' EXIT
trap 'exit 0' TERM INT HUP

while kill -0 "$parent" 2>/dev/null; do
  read -r -t 15 -u $mon _ || { [ $? -gt 128 ] && continue; exit 0; }   # timeout: keep going; EOF: the monitor died, exit so the panel restarts us
  while read -r -t 0.3 -u $mon _; do :; done     # a signal is a dozen lines: swallow them all, then look once
  cur=$(powerprofilesctl get) || continue
  [ "$cur" = "$last" ] && continue
  last=$cur
  [ -e "$HOME/.config/omarchy/fan/no-follow" ] && continue
  "$fan" "$(map "$cur")"
done
