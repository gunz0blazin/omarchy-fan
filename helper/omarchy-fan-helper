#!/bin/bash
# Root half of omarchy-fan. Installed as /usr/lib/omarchy-fan/helper and only ever run through
# pkexec (see org.omarchy.fan.policy). It takes a profile NAME or a level 0-8, never a path or
# a config, and builds /etc/thinkfan.yaml from the root-owned profiles in /usr/share/omarchy-fan.
set -e
profiles=/usr/share/omarchy-fan/profiles

# A pinned level ignores temperature, which would let a pinned "off" cook the CPU under load. So a pinned level 0-7 carries a
# safety row: above manual_cap C the fan goes to full speed, and it returns to the pinned level below manual_back C.
manual_cap=85
manual_back=80

write_manual() {  # level 0-7, or 8 for full speed
  local lv=$1
  { sed -e '/^levels:/,$d' -e '1s/.*/# omarchy-fan profile: manual/' "$profiles/balanced.yaml"
    if [ "$lv" = 8 ]; then
      printf 'levels:\n  - ["level full-speed", 0, 32767]\n'
    else
      printf 'levels:\n  - [%s, 0, %s]\n  - ["level full-speed", %s, 32767]\n' "$lv" "$manual_cap" "$manual_back"
    fi; } > /etc/thinkfan.yaml.new
  mv /etc/thinkfan.yaml.new /etc/thinkfan.yaml
}

# Never silently replace a thinkfan config the user wrote themselves: keep the first one as a backup.
backup_user_config() {
  if [ -e /etc/thinkfan.yaml ] && ! head -1 /etc/thinkfan.yaml | grep -q '^# omarchy-fan profile' \
     && [ ! -e /etc/thinkfan.yaml.omarchy-fan.bak ]; then
    cp -p /etc/thinkfan.yaml /etc/thinkfan.yaml.omarchy-fan.bak
  fi
}

restart_thinkfan() {
  systemctl reset-failed thinkfan 2>/dev/null || true
  systemctl restart thinkfan
}

case "$1" in
  set)
    backup_user_config
    case "$2" in
      quiet|balanced|performance) install -m644 "$profiles/$2.yaml" /etc/thinkfan.yaml ;;
      manual) [[ $3 =~ ^[0-8]$ ]] || { echo "level must be 0-8" >&2; exit 2; }; write_manual "$3" ;;
      *) echo "unknown profile" >&2; exit 2 ;;
    esac
    restart_thinkfan ;;
  ensure-module)
    # Run by thinkfan.service just before it starts (see the zz-omarchy-fan.conf drop-in). thinkpad_acpi is
    # often loaded very early at boot, from the initramfs, without our fan_control=1 option, and thinkfan
    # then refuses to start. Reload the module with the option if it is off. Never fails the service start.
    if [ "$(cat /sys/module/thinkpad_acpi/parameters/fan_control 2>/dev/null)" != Y ]; then
      modprobe -r thinkpad_acpi 2>/dev/null || true
      modprobe thinkpad_acpi fan_control=1 2>/dev/null || true
    fi
    exit 0 ;;
  enable)
    # thinkfan needs fan_control=1 on thinkpad_acpi and a config to start from.
    "$0" ensure-module
    [ -e /etc/thinkfan.yaml ] || install -m644 "$profiles/balanced.yaml" /etc/thinkfan.yaml
    systemctl enable --now thinkfan ;;
  *) echo "usage: helper set <quiet|balanced|performance> | set manual <0-8> | enable" >&2; exit 2 ;;
esac
